---
import { isUsableSummary, plainText } from '../../tools/plain-text.mjs';

const { slide, masthead, dateLabel, index, count } = Astro.props;
const media = slide.image;
const summary = isUsableSummary(slide.summary, slide.title) ? plainText(slide.summary) : '';
const description = plainText(slide.description);
// Until the summarizer gets to this story, the feed's own text takes the lead
// slot - an empty box in the middle of the slide would read as a mistake.
const lead = summary || description;
const rest = summary ? description : '';
---

<div class="slide">
  <div class="slide-inner">
    <div class="masthead-block">
      <img class="inky" src="/img/inky.svg" alt="" width="32" height="32" />
      <div class="masthead-title">{masthead}</div>
      <div class="masthead-meta">
        <span class="left">{dateLabel}</span>
        <span class="right">{index} / {count}</span>
        <span class="center">
          <a class="stamp-link" href="https://github.com/kumanaya/eink-news">
            <img src="/img/github.svg" alt="" width="12" height="12" />
            eink-news
          </a>
          <a class="stamp-link" href="https://x.com/danielkumanaya">
            <img src="/img/x.svg" alt="" width="12" height="12" />
            danielkumanaya
          </a>
          <a class="stamp-link" href="https://discord.gg/KYChSeuyk">
            <img src="/img/discord.svg" alt="" width="12" height="12" />
            discord
          </a>
        </span>
      </div>
    </div>

    <div class="section">{slide.section}</div>

    <!-- data-min/data-max are the font sizes the fit script may choose from,
         in vh: the box around them never moves, the type inside does. -->
    <h1 class="headline fit" data-min="3" data-max="6.4">
      <a href={slide.link}>{slide.title}</a>
    </h1>

    <div class="media">
      <!-- data-src: the board's script puts it in src when the story comes
           up. With hundreds of slides, loading every picture at once would
           sink the Kindle's browser. The well is always 26vh; the picture
           fills it (cropped if the ratio differs), so a tall photo and a
           wide one leave every block in the same place. -->
      {media && <img data-src={media} alt="" />}
    </div>

    <p class="summary fit" data-min="1.8" data-max="3.1">{lead}</p>
    <p class="description fit" data-min="1.5" data-max="2.3">{rest}</p>

    <div class="byline">
      <span class="byline-when">{dateLabel} · </span>By {slide.byline}{slide.dateline ? ` · ${slide.dateline}` : ''}
    </div>
  </div>
</div>
