---
import '../styles/sign.css';

const { masthead, refresh, track, night } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[night && 'night']}>
  <head>
    {night && (
      <script is:inline>
        (function () {
          var ua = navigator.userAgent || '';
          if (!/Kindle|Silk/i.test(ua)) return;
          var html = document.documentElement;
          html.className = html.className.replace(/(^|\s)night(\s|$)/, ' ');
        })();
      </script>
    )}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {night && <meta name="theme-color" content="#1c1a17" />}
    <link rel="icon" href="/favicon.ico" />
    {refresh && <meta http-equiv="refresh" content={String(refresh)} />}
    <title>{masthead}</title>
    {track && (
      <>
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-85QTN3XFK6" is:inline></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-85QTN3XFK6');
        </script>
      </>
    )}
  </head>
  <body>
    <slot />

    <!--
      The board script, in plain ES5 (the Kindle's browser is old, and its
      bundler-free parser takes no arrows or backticks). The Google tag above
      is only on the live site, not on the photographed slides.

      - fitAll shrinks the type inside the fixed boxes until it fits. CSS cannot
        measure text, and a headline that pushes the story down the screen
        breaks the signboard - the boxes hold their place, the font is what
        gives.
      - rotate is the signboard itself. It is a timer, not a CSS animation,
        because the Kindle browser does not run those and the board would sit
        on the first story forever. A tap on the left third goes back, a tap
        on the right third goes forward, the same way the Kindle turns a page.
    -->
    <script is:inline>
      (function () {
        var started = false;
        function fitAll() {
          var nodes = document.querySelectorAll('.fit');
          for (var i = 0; i < nodes.length; i++) {
            var el = nodes[i];
            var min = parseFloat(el.getAttribute('data-min'));
            var max = parseFloat(el.getAttribute('data-max'));
            var size = max;
            el.style.fontSize = max + 'vh';
            while (size > min && el.scrollHeight > el.clientHeight + 1) {
              size -= 0.2;
              el.style.fontSize = size + 'vh';
            }
          }
        }
        function loadImg(slide) {
          if (!slide) return;
          var img = slide.querySelector('img[data-src]');
          if (img && !img.getAttribute('src')) img.setAttribute('src', img.getAttribute('data-src'));
        }
        function show(slides, index) {
          var n = slides.length;
          for (var i = 0; i < n; i++) slides[i].style.opacity = i === index ? 1 : 0;
          loadImg(slides[index]);
          loadImg(slides[(index + 1) % n]);
          loadImg(slides[(index + n - 1) % n]);
        }
        function rotate() {
          var board = document.querySelector('.board');
          var slides = document.querySelectorAll('.slide');
          if (!board) return;
          if (board.className.indexOf('standalone') !== -1) { loadImg(slides[0]); return; }
          if (slides.length < 2) { loadImg(slides[0]); return; }
          var sec = parseFloat(board.getAttribute('data-seconds')) || 8;
          var n = slides.length, cur = 0, timer = null, last = 0;
          function step(d) { cur = (cur + d + n) % n; show(slides, cur); }
          function arm() {
            if (timer) clearInterval(timer);
            timer = setInterval(function () { step(1); }, sec * 1000);
          }
          function tap(e) {
            e = e || window.event;
            var now = new Date().getTime();
            if (now - last < 400) return;
            var t = e.changedTouches && e.changedTouches[0];
            var x = t ? t.clientX : e.clientX;
            var w = board.clientWidth || document.body.clientWidth;
            var d = x < w / 3 ? -1 : x > (2 * w) / 3 ? 1 : 0;
            if (!d) return;
            last = now;
            if (e.preventDefault) e.preventDefault();
            step(d);
            arm();
          }
          show(slides, cur);
          arm();
          if (board.addEventListener) {
            board.addEventListener('click', tap, false);
            board.addEventListener('touchend', tap, false);
          } else board.onclick = tap;
        }
        function start() {
          if (started) return;
          started = true;
          fitAll();
          rotate();
        }
        start();
        if (window.addEventListener) window.addEventListener('load', start, false);
        else window.onload = start;
      })();
    </script>
  </body>
</html>
